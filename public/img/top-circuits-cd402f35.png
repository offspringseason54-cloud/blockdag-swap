    }

    div:where(.swal2-container) button:where(.swal2-styled):where(.swal2-confirm):focus-visible {
      box-shadow: 0 0 0 3px rgba(112, 102, 224, .5)
    }

    div:where(.swal2-container) button:where(.swal2-styled):where(.swal2-deny) {
