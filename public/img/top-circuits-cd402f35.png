    }

    div:where(.swal2-container) button:where(.swal2-styled):where(.swal2-deny):focus-visible {
      box-shadow: 0 0 0 3px rgba(220, 55, 65, .5)
    }

    div:where(.swal2-container) button:where(.swal2-styled):where(.swal2-cancel) {
