            <div
              class="bg-gradient-to-b from-[#11314a] to-[#0c2539] overflow-hidden border border-[#224765] rounded-[10px] p-8 relative">
              <p class="text-sm tracking-[0.37px] text-[#76b0de]">01</p>
              <p class="text-xl md:text-3xl font-semibold tracking-[0.8px]">Decentral</p><img
                src="./assets/decentral-4d5a9504.png" alt="Blur" class="absolute bottom-0 left-0">
            </div>
            <div
              class="bg-gradient-to-b from-[#11314a] to-[#0c2539] overflow-hidden border border-[#224765] rounded-[10px] p-8 relative">
              <p class="text-sm tracking-[0.37px] text-[#76b0de]">02</p>
